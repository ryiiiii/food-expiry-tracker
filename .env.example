# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ローカル開発（SQLite）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL="file:./dev.db"
# DATABASE_AUTH_TOKEN は不要（ローカルSQLiteの場合）

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  本番環境（Turso / libsql）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DATABASE_URL="libsql://your-db-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  LINE 通知（LINE公式アカウントの Messaging API）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LINE Developers コンソール → Messaging API チャネル → Messaging API 設定 で発行（長期）
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token
# 通知を受け取る人のユーザーID（U で始まる33文字）。複数人はカンマ区切り
LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  Vercel Cron Jobs セキュリティ
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ランダムな文字列を設定: openssl rand -hex 32
CRON_SECRET=your-secret-token-here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ログイン
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# セッション署名用の秘密鍵（32文字以上）: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string-32chars-or-more

# 質問と答え（答えは YYYYMMDD の8桁）。名前ごとに複数用意すると、ログイン時にランダムで1つ出題される。
# 答えはサーバー側だけで照合され、ブラウザには送られない。実際の値は .env.local / Vercel にだけ設定し、コミットしないこと。
LOGIN_QUESTIONS={"ryo":[{"id":"wedding","text":"結婚記念日は？","answer":"20000101"},{"id":"dating","text":"付き合った記念日は？","answer":"20000102"}],"madoka":[{"id":"wedding","text":"結婚記念日は？","answer":"20000101"},{"id":"dating","text":"付き合った記念日は？","answer":"20000102"}]}

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  レシート読み取り（Google AI / Gemini API）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Google AI Studio（https://aistudio.google.com/apikey）で発行したAPIキー
GEMINI_API_KEY=your-gemini-api-key
# 使うモデル（省略可。省略時は gemini-3.5-flash-lite）。モデルの提供終了時はここで差し替える
# GEMINI_MODEL=gemini-3.5-flash-lite
