// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 一度でも登録した食品名の履歴（削除されても残す）
model FoodName {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

// 買い物リスト
model ShoppingItem {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Int?
  unit      String?
  checked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Food {
  id         Int       @id @default(autoincrement())
  name       String
  expiryType String    // "消費期限" | "賞味期限"
  expiryDate DateTime? // 冷凍時は不要なので nullable
  quantity   Int?      // 数量（任意）
  unit       String?   // 単位（個・本・パックなど）
  frozen     Boolean   @default(false) // 冷凍庫フラグ
  category   String?   // カテゴリ（任意）
  memo       String?
  notified   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// 家計管理
model Expense {
  id          Int      @id @default(autoincrement())
  amount      Int      // 金額（円）
  category    String   // "食品・日用品" | "外食" | "光熱費" | "家賃" | "その他" | "結婚式・旅行代の返済"
  description String?  // その他の場合の詳細
  memo        String?  // メモ（任意）
  isFixed     Boolean  @default(false) // false=変動, true=固定
  payer       String   // "まどか" | "りょう"
  date        DateTime // 支払日
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 毎月自動挿入する固定費の定義
model RecurringExpense {
  id          Int      @id @default(autoincrement())
  amount      Int
  category    String
  description String?
  memo        String?
  payer       String
  startYear   Int      // 開始年（例: 2026）
  startMonth  Int      // 開始月（例: 7）
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
